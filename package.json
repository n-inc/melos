{
  "name": "@n-inc/melos",
  "version": "0.8.0",
  "description": "Autonomous agent loop system",
  "license": "MIT",
  "type": "module",
  "bin": {
    "melos": "./bin/melos.js"
  },
  "files": [
    "bin",
    "dist",
    "prompts",
    "src"
  ],
  "scripts": {
    "melos": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:tui": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/ui/__tests__/tui.test.ts src/ui/__tests__/tui-contract.test.ts src/ui/__tests__/tui-runtime-screen.test.ts src/ui/__tests__/tui-views.test.ts src/ui/__tests__/tui-keymap.test.ts --runInBand",
    "test:tui:visual": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/ui/__tests__/tui-visual.test.ts --runInBand",
    "build": "tsc"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-inc/melos.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  },
  "dependencies": {
    "commander": "^14.0.2"
  }
}
